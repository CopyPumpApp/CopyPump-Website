{
  "name": "copypump-site",
  "private": true,
  "version": "47.4.0-review",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "preview": "node server/index.mjs --serve-dist",
    "start": "node server/index.mjs --serve-dist",
    "check:clean": "node scripts/clean-public-audit.mjs",
    "check": "npm run typecheck && npm run check:clean && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
