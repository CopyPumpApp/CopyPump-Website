{
  "name": "copypump-site",
  "private": true,
  "version": "47.4.0-review",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-8787}",
    "check:clean": "node scripts/clean-public-audit.mjs",
    "check:ui": "node scripts/ui-regression-audit.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run check:clean && npm run check:ui && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
